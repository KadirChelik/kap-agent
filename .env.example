# Gemini API (Google AI Studio Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Optional Free-Tier Fallback Providers (Groq & OpenRouter)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
LLM_MIN_INTERVAL_SEC=1.2
API_GLOBAL_RATE_LIMIT_PER_MIN=60

# Database, Continuous KAP Sync & Pipeline paths (relative to repo root or absolute)
KAP_DB_PATH=data/kap_agent.db
KAP_USER_AGENT=KAPAgentPortfolio/1.0 (+https://github.com/KadirChelik/kap-agent)
KAP_AUTO_SYNC_ENABLED=true
KAP_SYNC_INTERVAL_SEC=900
KAP_SYNC_LOOKBACK_DAYS=14
KAP_SYNC_LIMIT_PER_TICKER=5

# Admin approval token for review_flags moderation
ADMIN_TOKEN=dev-admin-token
